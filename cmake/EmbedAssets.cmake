file(GLOB_RECURSE ASSET_FILES RELATIVE "${ROOT_DIR}" "${ROOT_DIR}/${ASSETS_DIR}/*")
list(FILTER ASSET_FILES EXCLUDE REGEX ":[^/]*$")
list(SORT ASSET_FILES)

set(CONTENT "// generated by cmake/EmbedAssets.cmake, do not edit\n")
string(APPEND CONTENT "#include \"Resources/Resources.hpp\"\n\n")
string(APPEND CONTENT "#include <cstring>\n\nnamespace {\n\n")

set(TABLE "")
set(INDEX 0)
set(HASHES "")
foreach(ASSET ${ASSET_FILES})
    file(MD5 "${ROOT_DIR}/${ASSET}" ASSET_HASH)
    string(APPEND HASHES "${ASSET}:${ASSET_HASH};")
    file(READ "${ROOT_DIR}/${ASSET}" HEX_DATA HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," HEX_DATA "${HEX_DATA}")
    string(APPEND CONTENT "const unsigned char asset${INDEX}[] = {${HEX_DATA}0};\n")
    string(APPEND TABLE "    {\"${ASSET}\", asset${INDEX}, sizeof(asset${INDEX}) - 1},\n")
    math(EXPR INDEX "${INDEX} + 1")
endforeach()

string(MD5 BUILD_ID "${HASHES}")

string(APPEND CONTENT "
const rtype::res::EmbeddedAsset entries[] = {
${TABLE}};

} // namespace

namespace rtype::res {

std::span<const EmbeddedAsset> embeddedAssets() {
  return entries;
}

std::string_view embeddedBuildId() {
  return \"${BUILD_ID}\";
}

} // namespace rtype::res
")

file(WRITE "${OUTPUT}.tmp" "${CONTENT}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
