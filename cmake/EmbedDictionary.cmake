file(READ "${DICTIONARY}" HEX_DATA HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," HEX_DATA "${HEX_DATA}")

set(CONTENT "// generated by cmake/EmbedDictionary.cmake, do not edit\n")
string(APPEND CONTENT "#include \"protocol/Compression.hpp\"\n\n")
string(APPEND CONTENT "namespace {\n\n")
string(APPEND CONTENT "const unsigned char dictionary[] = {${HEX_DATA}0};\n\n")
string(APPEND CONTENT "} // namespace\n")

string(APPEND CONTENT "
std::span<const std::uint8_t> compressionDictionary() {
  return {dictionary, sizeof(dictionary) - 1};
}
")

file(WRITE "${OUTPUT}.tmp" "${CONTENT}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
