{
  "name": "rtype",
  "version": "1.2.1",
  "dependencies": [
    "asio",
    "glm",
    "miniaudio",
    "stb",
    "vulkan-headers",
    "nlohmann-json"
  ],
  "features": {
    "client": {
      "description": "Vulkan loader for the client (needs X11/xcb/wayland headers on Linux)",
      "dependencies": [
        {
          "name": "vulkan-loader",
          "platform": "linux",
          "features": ["xlib", "xcb", "wayland"]
        },
        {
          "name": "vulkan-loader",
          "platform": "windows"
        }
      ]
    }
  }
}
